<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve manifest.json directly with correct headers (prevents LiteSpeed caching issues)
    RewriteCond %{REQUEST_URI} ^/manifest\.json$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# LiteSpeed Cache Control - prevent caching of dynamic PHP responses
<IfModule LiteSpeed>
    # Disable public cache for all PHP-generated content
    CacheDisable public /
    # Ensure private cache is also disabled for session pages
    CacheDisable private /
    # Force no-cache header on all responses
    Header always set X-LiteSpeed-Cache-Control no-cache
</IfModule>

# Fallback: if mod_headers is available but LiteSpeed module isn't
<IfModule mod_headers.c>
    Header always set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    # CRITICAL: Prevent LiteSpeed from stripping Set-Cookie header
    Header always edit Set-Cookie ^(.*)$ $1; HttpOnly; Secure; SameSite=Lax
</IfModule>

# Explicitly protect session cookie for login/register routes
<IfModule mod_headers.c>
    <FilesMatch "^(login|register)$">
        Header always set Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0"
        Header always edit Set-Cookie ^(.*)$ $1; HttpOnly; Secure; SameSite=Lax
    </FilesMatch>
</IfModule>

# Ensure manifest.json is served with correct Content-Type and no caching
<IfModule mod_mime.c>
    AddType application/manifest+json .json
</IfModule>
<Files "manifest.json">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</Files>
